# ── Wajib ──
ADMIN_USER=Admin
ADMIN_PASS=ganti-dengan-password-kuat
ADMIN_SECRET=string-acak-panjang-minimal-32-karakter

# Database (https://upstash.com → Redis → tab REST API)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# Penyimpanan APK = repo GitHub PUBLIC khusus file (sama seperti nexfind)
GITHUB_TOKEN=github_pat_xxxx          # fine-grained, Repository permissions: Contents Read and write
GITHUB_USR=username-github-kamu
GITHUB_REPO=nexrify-files             # nama repo saja

# ── Opsional ──
GITHUB_BRANCH=main
MAX_UPLOAD_MB=90
SITE_URL=https://nexrify.biz.id
# Kontak yang tampil di footer dan halaman bantuan (kosongkan kalau tidak mau ditampilkan)
CONTACT_EMAIL=
CONTACT_TELEGRAM=
CONTACT_WHATSAPP=

# Global Chat: username yang mendapat lencana "Staf" (pisahkan dengan koma)
CHAT_ADMIN=
CHAT_STAFF=

# ===== Donasi / Dukung Developer =====
# Bukti donasi dikirim ke Telegram owner (buat bot lewat @BotFather, chat ID lewat @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# DANA tujuan transfer (bisa juga diubah dari panel, tab Donasi)
DANA_ACCOUNT_NAME=
DANA_ACCOUNT_NUMBER=
# QRIS statis: halaman ibb (gambar diambil otomatis) atau link gambar langsung (opsional)
QRIS_PAGE_URL=https://ibb.co.com/0pgswcyD
QRIS_IMAGE_URL=
